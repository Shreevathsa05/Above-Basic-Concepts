generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Student {
  id        Int      @id @default(autoincrement())
  name      String
  roll_no   String   @unique
  age       Int
  class     String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}
